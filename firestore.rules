rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 檢查請求用戶是否為超級管理員 nicholas@gmii.tw
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'nicholas@gmii.tw';
    }

    // 檢查請求用戶是否為該文檔擁有者
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 用戶基本資料與個人化同步數據 (Watchlist, Holdings, Alerts)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // ⚠**等級提權防線（2026-08-06 補）**：原本是 `allow read, write`，
      //   等於任何登入者都能對自己的 user doc 寫 `level: 'superadmin'` 自我提權。
      //   現在：建檔只能給 registered；更新時 level 必須與現值相同（＝不准自己改）。
      //   改等級只有兩條合法路徑——管理員後台（isAdmin）與 daemon（Admin SDK 繞過規則）。
      allow create: if isAdmin() ||
        (isOwner(userId) && request.resource.data.get('level', 'registered') == 'registered');
      allow update: if isAdmin() ||
        (isOwner(userId) && request.resource.data.get('level', null) == resource.data.get('level', null));
      allow delete: if isAdmin();

      match /data/{document} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // 決策歸因快照（下單當下的榜單/判讀/足跡 PIT 記錄；每筆買入一份）
      match /ctx/{document} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 使用記錄集合 (Activity Logs)
    match /activity_logs/{logId} {
      // 任何登入的使用者皆可新增操作日誌
      allow create: if request.auth != null;
      // 僅限超級管理員可以讀取與修改日誌
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // 營運數據彙總（daemon 每日寫入；僅超級管理員可讀，前台不可見）
    match /userPerf/{doc} { allow read: if isAdmin(); }
    match /platformStats/{doc} { allow read: if isAdmin(); }
    match /featureAttribution/{doc} { allow read: if isAdmin(); }
    match /usageSummary/{doc} { allow read: if isAdmin(); }
    match /tailTrack/{doc} { allow read: if isAdmin(); }   // 撿尾盤實盤前追蹤（每日存證＋滾動彙總）

    // 系統狀態設定檔 (Agent 遠端控制心跳檔)
    match /system/monitor-agent {
      // 允許 API 及客戶端公開讀取狀態，僅限管理員寫入/修改
      allow read: if true;
      // 安全修正 (2026-07-30)：原本有 `|| request.auth == null`，
      // 等於任何未登入者都能直接改寫 agent 心跳／開關。
      allow write: if isAdmin();
    }
  }
}
