#!/bin/sh
# 台股助手 pre-commit 閘門（wm-ci-guardrails·2026-09-04）
# 目的：磁碟上任何時刻不可放語法壞碼——launchd 會在 daemon 死亡時拉起磁碟版
#（2026-08-31 `_sma` 重複宣告 crash loop 事故）。輕量兩項，~3 秒；tsc 放 pre-push。
cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0
for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '^scripts/.*\.mjs$'); do
  node --check "$f" || { echo "❌ 語法錯誤：$f"; fail=1; }
done
if git diff --cached --name-only | grep -qE '\.(ts|tsx|mjs)$'; then
  node scripts/check-field-conventions.mjs >/tmp/fc.out 2>&1 || { cat /tmp/fc.out; echo "❌ 欄位命名契約違規（先到 check-field-conventions.mjs 登記）"; fail=1; }
fi
if git diff --cached --name-only | grep -qE '^src/'; then
  node scripts/audit-routes.mjs >/tmp/ar.out 2>&1 || { cat /tmp/ar.out; echo "❌ route 封閉世界普查違規（scripts/route-policy.json）"; fail=1; }
  node scripts/audit-ratchets.mjs >/tmp/rt.out 2>&1 || { cat /tmp/rt.out; echo "❌ Ratchet 違規（setInterval 未接 gate）"; fail=1; }
  node scripts/enforce-safe-storage.mjs >/tmp/ss.out 2>&1 || { cat /tmp/ss.out; echo "❌ 原生 localStorage 呼叫（改用 @/lib/safe-storage）"; fail=1; }
fi
# scripts/lib 單元測試（2026-09-28·WM-SCAN G3-08／G4-14）：daemon 的純函式與執行器都在 scripts/lib，
# 測試原本沒接任何閘門 ⇒ 改壞了照樣 commit、disk 即部署。只在動到 scripts/lib/ 時跑（~0.2 秒）。
if git diff --cached --name-only | grep -qE '^scripts/lib/'; then
  set -- scripts/lib/*.test.mjs
  if [ -e "$1" ]; then
    node --test "$@" >/tmp/lt.out 2>&1 || { cat /tmp/lt.out; echo "❌ scripts/lib 單元測試失敗（node --test scripts/lib/*.test.mjs）"; fail=1; }
    [ $fail -eq 0 ] && echo "✓ scripts/lib 單元測試通過（$# 檔）"
  fi
fi
# 外部資料來源登錄（2026-09-28·wm-source-legitimacy／WM-SCAN G4-10）：程式碼出現未登錄或未核准的網域即擋。
if git diff --cached --name-only | grep -qE '^(src/|scripts/)'; then
  node scripts/check-source-registry.mjs >/tmp/sr.out 2>&1 || { cat /tmp/sr.out; echo "❌ 外部來源未登錄／未核准（scripts/source-registry.json，見 wm-source-legitimacy）"; fail=1; }
fi
[ $fail -eq 0 ] && echo "✓ pre-commit：語法＋欄位契約＋route 普查＋ratchet＋safe-storage＋來源登錄 通過"
exit $fail
